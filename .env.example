# Query-role credentials only. Do not put a deploy role here.
# The API never returns these values. Do not commit a real .env file.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# table, schema.table, or database.schema.table with columns line and content
SNOWFLAKE_MANIFEST_TABLE=

# Set one of these. A private key may be a PEM string or a filesystem path.
# If both are set, the private key is used.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY=

# Read-only GitHub access (contents:read). Never a token with push scope.
GITHUB_TOKEN=
GITHUB_REPO=owner/name
GITHUB_BRANCH=main

# Optional local dbt project used when compiling pasted SQL or diffing files.
DBT_PROJECT_DIR=
